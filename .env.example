# Copy this file to .env.local and fill in the values you need.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser; the rest stay on the server.

# Public hCaptcha site key for the invisible captcha on the contact form.
# Create a site at https://dashboard.hcaptcha.com and copy its site key.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=

# hCaptcha secret key. /api/contact uses it to verify the captcha token.
# Same hCaptcha dashboard, under your account settings.
HCAPTCHA_SECRET_KEY=

# Token of the Telegram bot that delivers contact form messages.
# Create a bot with @BotFather on Telegram and copy the token it gives you.
TELEGRAM_BOT_TOKEN=

# Telegram chat id the bot sends those messages to (your user id or a group id).
# Get it from @userinfobot, or from the bot's getUpdates endpoint after messaging it.
TELEGRAM_CHAT_ID=

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Leave empty to keep analytics off.
# Google Analytics admin, Data streams, your web stream.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
